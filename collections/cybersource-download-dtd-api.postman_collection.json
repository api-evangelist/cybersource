          "name": "Download DTD for Report",
          "request": {
            "name": "Download DTD for Report",
            "description": {
              "content": "Used to download DTDs for reports on no-auth.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "reporting",
                "v3",
                "dtds",
                ":reportDefinitionNameVersion"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "reportDefinitionNameVersion",
                  "description": "(Required) Name and version of DTD file to download. Some DTDs only have one version. In that case version name is not needed. Some example values are ctdr-1.0, tdr, pbdr-1.1"
                }
              ]
            },
            "method": "GET",
            "auth": null
          },
