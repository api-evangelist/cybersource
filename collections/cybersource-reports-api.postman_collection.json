        {
          "id": "0875e112-fd43-4ac5-bdfc-0a1fa99e9e16",
          "name": "Retrieve Available Reports",
          "request": {
            "name": "Retrieve Available Reports",
            "description": {
              "content": "Retrieve a list of the available reports to which you are subscribed. This will also give you the reportId value, which you can also use to download a report.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "reporting",
                "v3",
                "reports"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "organizationId",
                  "value": "<string>",
                  "description": "Valid Organization Id"
                },
                {
                  "disabled": false,
                  "key": "startTime",
                  "value": "<dateTime>",
                  "description": "(Required) Valid report Start Time in **ISO 8601 format**\nPlease refer the following link to know more about ISO 8601 format.[Rfc Date Format](https://xml2rfc.tools.ietf.org/public/rfc/html/rfc3339.html#anchor14)\n\n**Example date format:**\n  - yyyy-MM-dd'T'HH:mm:ss.SSSZ (e.g. 2018-01-01T00:00:00.000Z)\n"
                },
                {
                  "disabled": false,
                  "key": "endTime",
                  "value": "<dateTime>",
                  "description": "(Required) Valid report End Time in **ISO 8601 format**\nPlease refer the following link to know more about ISO 8601 format.[Rfc Date Format](https://xml2rfc.tools.ietf.org/public/rfc/html/rfc3339.html#anchor14)\n\n**Example date format:**\n  - yyyy-MM-dd'T'HH:mm:ss.SSSZ (e.g. 2018-01-01T00:00:00.000Z)\n"
                },
                {
                  "disabled": false,
                  "key": "timeQueryType",
                  "value": "<string>",
                  "description": "(Required) Specify time you would like to search\n\nValid values:\n- reportTimeFrame\n- executedTime\n"
                },
                {
                  "disabled": false,
                  "key": "reportMimeType",
                  "value": "<string>",
                  "description": "Valid Report Format\n\nValid values:\n- application/xml\n- text/csv\n"
                },
                {
                  "disabled": false,
                  "key": "reportFrequency",
                  "value": "<string>",
                  "description": "Valid Report Frequency\n\nValid values:\n- DAILY\n- WEEKLY\n- MONTHLY\n- USER_DEFINED\n- ADHOC\n"
                },
                {
                  "disabled": false,
                  "key": "reportName",
                  "value": "<string>",
                  "description": "Valid Report Name"
                },
                {
                  "disabled": false,
                  "key": "reportDefinitionId",
                  "value": "<integer>",
                  "description": "Valid Report Definition Id"
                },
                {
                  "disabled": false,
                  "key": "reportStatus",
                  "value": "<string>",
                  "description": "Valid Report Status\n\nValid values:\n- COMPLETED\n- PENDING\n- QUEUED\n- RUNNING\n- ERROR\n- NO_DATA\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/hal+json"
              }
            ],
            "method": "GET",
            "auth": null
