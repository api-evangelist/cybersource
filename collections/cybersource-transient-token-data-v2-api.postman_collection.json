              "body": "{\n  \"paymentInformation\": {\n    \"card\": {\n      \"expirationYear\": \"2026\",\n      \"number\": \"XXXXXXXXXXXX1111\",\n      \"expirationMonth\": \"05\",\n      \"type\": \"001\"\n    }\n  },\n  \"orderInformation\": {\n    \"amountDetails\": {\n      \"totalAmount\": \"21.00\",\n      \"currency\": \"USD\"\n    },\n    \"billTo\": {\n      \"lastName\": \"Solo\",\n      \"country\": \"US\",\n      \"firstName\": \"Han\",\n      \"email\": \"Han.solo@test.com\"\n    },\n    \"shipTo\": {\n      \"locality\": \"Mos Eisley\",\n      \"country\": \"US\",\n      \"administrativeArea\": \"CA\",\n      \"address1\": \"325 Falcon Way\",\n      \"postalCode\": \"94545\"\n    }\n  }\n}",
