          "name": "Get Transient Token Data",
          "request": {
            "name": "Get Transient Token Data",
            "description": {
              "content": "Retrieve the data captured by Unified Checkout. This API is used to retrieve the detailed data represented by the Transient Token. This API will not return PCI payment data (PAN). Include the Request ID in the GET request to retrieve the transaction details.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "up",
                "v1",
                "payment-details",
                ":transientToken"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "transientToken",
                  "description": "(Required) Transient Token returned by the Unified Checkout application.\n"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
