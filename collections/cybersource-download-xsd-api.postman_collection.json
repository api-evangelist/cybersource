          "id": "bd194d94-0863-4e3d-bfc7-db895ff0716f",
          "name": "Download XSD for Report",
          "request": {
            "name": "Download XSD for Report",
            "description": {
              "content": "Used to download XSDs for reports on no-auth.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "reporting",
                "v3",
                "xsds",
                ":reportDefinitionNameVersion"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "reportDefinitionNameVersion",
                  "description": "(Required) Name and version of XSD file to download. Some XSDs only have one version. In that case version name is not needed. Some example values are DecisionManagerDetailReport, DecisionManagerTypes"
                }
              ]
            },
            "method": "GET",
            "auth": null
          },
