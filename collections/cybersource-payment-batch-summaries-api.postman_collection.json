      "item": [
        {
          "id": "50edfbb1-d872-4d22-9e18-f06175b576be",
          "name": "Get Payment Batch Summary Data",
          "request": {
            "name": "Get Payment Batch Summary Data",
            "description": {
              "content": "Scope can be either account/merchant or reseller.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "reporting",
                "v3",
                "payment-batch-summaries"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "startTime",
                  "value": "<dateTime>",
                  "description": "(Required) Valid report Start Time in **ISO 8601 format**\nPlease refer the following link to know more about ISO 8601 format.[Rfc Date Format](https://xml2rfc.tools.ietf.org/public/rfc/html/rfc3339.html#anchor14)\n\n**Example date format:**\n  - yyyy-MM-dd'T'HH:mm:ss.SSSZ (e.g. 2018-01-01T00:00:00.000Z)\n"
                },
                {
                  "disabled": false,
                  "key": "endTime",
                  "value": "<dateTime>",
                  "description": "(Required) Valid report End Time in **ISO 8601 format**\nPlease refer the following link to know more about ISO 8601 format.[Rfc Date Format](https://xml2rfc.tools.ietf.org/public/rfc/html/rfc3339.html#anchor14)\n\n**Example date format:**\n  - yyyy-MM-dd'T'HH:mm:ss.SSSZ (e.g. 2018-01-01T00:00:00.000Z)\n"
                },
                {
                  "disabled": false,
                  "key": "organizationId",
                  "value": "<string>",
                  "description": "Valid Organization Id"
                },
                {
                  "disabled": false,
                  "key": "rollUp",
                  "value": "<string>",
                  "description": "Conditional - RollUp for data for day/week/month. Required while getting breakdown data for a Merchant"
                },
                {
                  "disabled": false,
                  "key": "breakdown",
                  "value": "<string>",
                  "description": "Conditional - Breakdown on account_rollup/all_merchant/selected_merchant. Required while getting breakdown data for a Merchant."
                },
                {
                  "disabled": false,
                  "key": "startDayOfWeek",
                  "value": "<integer>",
                  "description": "Optional - Start day of week to breakdown data for weeks in a month"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/hal+json"
              }
            ],
            "method": "GET",
            "auth": null
          },
